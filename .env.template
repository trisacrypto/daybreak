# General
DAYBREAK_MAINTENANCE=false
DAYBREAK_MODE=release
DAYBREAK_LOG_LEVEL=debug
DAYBREAK_CONSOLE_LOG=true
DAYBREAK_DATABASE_URL=sqlite3:///tmp/daybreak.db

# Web server configuration
# Note you must use TLS for local development; use Caddy ad a proxy to localhost:8000.
DAYBREAK_BIND_ADDR=127.0.0.1:8000
DAYBREAK_ORIGIN=https://localhost

# Static files — default in code is pkg/web/static. After `go run ./cmd/build-assets` or
# `go generate ./...`, uncomment to serve the built tree (hashed JS/CSS + asset-manifest.json):
#DAYBREAK_STATIC_SERVE=true
#DAYBREAK_STATIC_ROOT=./pkg/web/dist
#DAYBREAK_STATIC_URL=/static

# Set the Google OAuth2 credentials for authentication.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these email domains are allowed to authenticate.
DAYBREAK_AUTH_ALLOWED_DOMAINS=rotational.io
